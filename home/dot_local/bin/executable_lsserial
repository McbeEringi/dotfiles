#!/usr/bin/bash
for x in /sys/bus/usb-serial/devices/* ;do
TTY=$(readlink -f $x)
IF=$(dirname $TTY)
DEV=$(dirname $IF)
VID=$(cat $DEV/idVendor)
VENDOR=$(pcre2grep -o "$VID\s*\K.+" /usr/share/hwdata/usb.ids)
PID=$(cat $DEV/idProduct)
PRODUCT=$(pcre2grep -oM "$VID[\s\S]+?(?=\n[^\t])" /usr/share/hwdata/usb.ids|pcre2grep -o "$PID\s+\K.+")
NAME=$(basename $TTY)

echo -e " $NAME\t$PRODUCT"
done
